# Optional overrides for run_sh_fair launch scripts (source from verl-agent/).
# Omit these exports to use the recipe-local defaults.
export VERL_OUTPUT_ROOT="$PWD/recipe/graph_guide/outputs"
export VERL_TENSORBOARD_ROOT="$PWD/recipe/graph_guide/tensorboard_fair"
export VERL_MODEL_ROOT="$PWD/recipe/graph_guide/models"
export ALFWORLD_DATA="$HOME/.cache/alfworld"
export VERL_DATA_ROOT="$PWD/recipe/graph_guide/data"
export VERL_VENV_ROOT="/path/to/verl-agent-venvs"
# Optional: point at an existing WebShop environment without renaming it.
export WEBSHOP_VENV_DIR="$VERL_VENV_ROOT/webshop"
export UV_PYTHON_INSTALL_DIR="$HOME/.local/share/uv/python"
# Optional: directory containing a newer libstdc++.so.6 for ALFWorld.
export ALFWORLD_LIBSTDCXX_DIR=""
export MODEL_PATH_1_5B="$VERL_MODEL_ROOT/Qwen2.5-1.5B-Instruct"
export MODEL_PATH_7B="$VERL_MODEL_ROOT/Qwen2.5-7B-Instruct"
