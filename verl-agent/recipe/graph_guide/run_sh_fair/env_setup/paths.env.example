# Optional overrides for run_sh_fair launch scripts.
export ALFWORLD_DATA="$HOME/.cache/alfworld"
export VERL_DATA_ROOT="/path/to/verl-agent-data"
export VERL_VENV_ROOT="/path/to/verl-agent-venvs"
export UV_PYTHON_INSTALL_DIR="$HOME/.local/share/uv/python"
# Optional: directory containing a newer libstdc++.so.6 for ALFWorld.
export ALFWORLD_LIBSTDCXX_DIR=""
export MODEL_PATH_1_5B="Qwen/Qwen2.5-1.5B-Instruct"
export MODEL_PATH_7B="Qwen/Qwen2.5-7B-Instruct"
